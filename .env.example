NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Admin Google OAuth
GOOGLE_CLIENT_ID="YOUR_ADMIN_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_ADMIN_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/auth/google/callback
ADMIN_EMAIL=amuzesh.sara@gmail.com

# Separate user Google OAuth client
GOOGLE_USER_CLIENT_ID="YOUR_USER_GOOGLE_CLIENT_ID"
GOOGLE_USER_CLIENT_SECRET="YOUR_USER_GOOGLE_CLIENT_SECRET"
GOOGLE_USER_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Gemini AI API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Encrypted SQLite Backup & Maintenance Keys
BACKUP_ENCRYPTION_KEY="YOUR_BACKUP_ENCRYPTION_SECRET"
MAINTENANCE_SECRET_KEY="YOUR_MAINTENANCE_WEBHOOK_SECRET_KEY"
MAINTENANCE_BACKUP_INTERVAL_HOURS=6

